{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hyperact",
  "version": "0.0.0",
  "identifier": "com.farzher.hyperact",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hyperact",
        "width": 680,
        "height": 420,
        "minWidth": 480,
        "minHeight": 280,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
