{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hyperact",
  "version": "0.0.0",
  "identifier": "com.farzher.hyperact",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "capabilities": [
      {
        "identifier": "main-window",
        "windows": ["main"],
        "permissions": [
          "core:window:default",
          "core:window:allow-start-dragging"
        ]
      }
    ],
    "windows": [
      {
        "label": "main",
        "title": "Hyperact",
        "width": 720,
        "height": 430,
        "minWidth": 720,
        "minHeight": 430,
        "maxWidth": 720,
        "maxHeight": 430,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
