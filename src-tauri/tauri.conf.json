{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hyperact",
  "version": "0.0.0",
  "identifier": "com.farzher.hyperact",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hyperact",
        "width": 720,
        "height": 430,
        "minWidth": 640,
        "minHeight": 360,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
